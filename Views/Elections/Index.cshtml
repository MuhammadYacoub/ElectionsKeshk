@model IEnumerable<AdvancedVotingSystem.Models.Election>
@{
    ViewData["Title"] = "إدارة الانتخابات";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-primary-50 text-primary-600 flex items-center justify-center border border-primary-100/50">
                <i class="fas fa-vote-yea text-sm"></i>
            </div>
            إدارة الانتخابات
        </h1>
        <p class="page-subtitle">إنشاء وتعديل وإدارة جميع الانتخابات في النظام</p>
    </div>
    <a asp-action="Create" class="ant-btn ant-btn-primary">
        <i class="fas fa-plus"></i>
        إضافة انتخابات جديدة
    </a>
</div>

<!-- Elections Table -->
<div class="ant-card">
    <div class="overflow-x-auto">
        <table class="ant-table">
            <thead>
                <tr>
                    <th>الاسم</th>
                    <th>تاريخ الانتخاب</th>
                    <th class="text-center">طريقة الدخول</th>
                    <th class="text-center">الحالة</th>
                    <th class="text-center">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="font-bold text-gray-900">@item.Name</td>
                        <td class="text-gray-500">@item.Date.ToShortDateString()</td>
                        <td class="text-center">
                            <span class="ant-tag ant-tag-info">
                                @if (item.EntryMethod == AdvancedVotingSystem.Models.Enums.EntryMethod.NationalId)
                                {
                                    <i class="fas fa-id-card text-[10px]"></i> @:الرقم القومي
                                }
                                else if (item.EntryMethod == AdvancedVotingSystem.Models.Enums.EntryMethod.KnownCode)
                                {
                                    <i class="fas fa-key text-[10px]"></i> @:كود دخول مسبق
                                }
                                else
                                {
                                    <i class="fas fa-question-circle text-[10px]"></i> @:كود دخول مجهول
                                }
                            </span>
                        </td>
                        <td class="text-center">
                            @if (item.Status == AdvancedVotingSystem.Models.Enums.ElectionStatus.Active)
                            {
                                <span class="ant-tag ant-tag-success">
                                    <span class="ant-tag-dot bg-success-500"></span> نشط
                                </span>
                            }
                            else if (item.Status == AdvancedVotingSystem.Models.Enums.ElectionStatus.Paused)
                            {
                                <span class="ant-tag ant-tag-warning">
                                    <span class="ant-tag-dot bg-amber-500"></span> موقوف
                                </span>
                            }
                            else
                            {
                                <span class="ant-tag ant-tag-danger">
                                    <span class="ant-tag-dot bg-danger-500"></span> مغلق
                                </span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="flex items-center justify-center gap-2 flex-wrap">
                                <a asp-action="Structure" asp-route-id="@item.Id" class="ant-btn ant-btn-primary ant-btn-sm">
                                    <i class="fas fa-sitemap text-xs"></i>
                                    الهيكل
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="ant-btn ant-btn-default ant-btn-sm">
                                    <i class="fas fa-edit text-xs"></i>
                                    تعديل
                                </a>

                                @if (item.Status != AdvancedVotingSystem.Models.Enums.ElectionStatus.Active)
                                {
                                    <form asp-action="ChangeStatus" method="post" class="inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="newStatus" value="Active" />
                                        <button type="submit" class="ant-btn ant-btn-success ant-btn-sm">
                                            <i class="fas fa-play text-xs"></i>
                                        </button>
                                    </form>
                                }

                                @if (item.Status == AdvancedVotingSystem.Models.Enums.ElectionStatus.Active)
                                {
                                    <form asp-action="ChangeStatus" method="post" class="inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="newStatus" value="Paused" />
                                        <button type="submit" class="ant-btn ant-btn-warning ant-btn-sm">
                                            <i class="fas fa-pause text-xs"></i>
                                        </button>
                                    </form>
                                }

                                @if (item.Status != AdvancedVotingSystem.Models.Enums.ElectionStatus.Closed)
                                {
                                    <form asp-action="ChangeStatus" method="post" class="inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="newStatus" value="Closed" />
                                        <button type="submit" class="ant-btn ant-btn-danger ant-btn-sm">
                                            <i class="fas fa-lock text-xs"></i>
                                        </button>
                                    </form>
                                }

                                <button type="button" onclick="openDeleteModal('@item.Id', '@item.Name')"
                                        class="ant-btn ant-btn-sm border border-danger-200 text-danger-600 bg-danger-50/30 hover:bg-danger-600 hover:text-white hover:border-danger-600">
                                    <i class="fas fa-trash text-xs"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete Modal -->
<div id="deleteModal" class="ant-modal-overlay hidden" style="display:none;">
    <div class="ant-modal">
        <div class="p-8 text-center">
            <div class="mx-auto w-20 h-20 rounded-full bg-danger-50 flex items-center justify-center mb-5">
                <i class="fas fa-exclamation-triangle text-danger-500 text-3xl"></i>
            </div>
            <h3 class="text-xl font-black text-gray-900 mb-2">تأكيد الحذف</h3>
            <p class="text-gray-500 mb-1 font-medium">
                هل أنت متأكد أنك تريد حذف انتخابات <strong id="modalElectionName" class="text-gray-900"></strong>؟
            </p>
            <p class="text-danger-500 text-xs font-bold mb-6">لا يمكن التراجع عن هذا الإجراء وسيتم حذف جميع البيانات المرتبطة.</p>

            <form id="deleteForm" method="post" action="/Elections/Delete">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteModalId" value="" />
                <div class="flex gap-3">
                    <button type="button" onclick="closeDeleteModal()" class="ant-btn ant-btn-default flex-1">إلغاء</button>
                    <button type="submit" class="ant-btn ant-btn-danger flex-1">
                        <i class="fas fa-trash"></i> نعم، احذف
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openDeleteModal(id, name) {
            document.getElementById('deleteModalId').value = id;
            document.getElementById('modalElectionName').textContent = '"' + name + '"';
            gsapOpenModal('deleteModal');
        }
        function closeDeleteModal() {
            gsapCloseModal('deleteModal');
        }
        document.getElementById('deleteModal').addEventListener('click', function(e) {
            if (e.target === this) closeDeleteModal();
        });
    </script>
}
