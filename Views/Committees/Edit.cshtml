@model AdvancedVotingSystem.Models.Committee
@using AdvancedVotingSystem.Models.Enums
@{
    ViewData["Title"] = "تعديل لجنة انتخابية";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-primary-50 text-primary-600 flex items-center justify-center border border-primary-100/50">
                <i class="fas fa-edit text-sm"></i>
            </div>
            تعديل بيانات اللجنة
        </h1>
        <p class="page-subtitle">@Model.Name</p>
    </div>
    <a href="/Committees/Index" class="ant-btn ant-btn-default"><i class="fas fa-arrow-right"></i> رجوع</a>
</div>

@if(TempData["SuccessMessage"] != null) { <div class="ant-alert ant-alert-success mb-5"><i class="fas fa-check-circle mt-0.5"></i> <span>@TempData["SuccessMessage"]</span></div> }
@if(TempData["ErrorMessage"] != null) { <div class="ant-alert ant-alert-error mb-5"><i class="fas fa-exclamation-circle mt-0.5"></i> <span>@TempData["ErrorMessage"]</span></div> }

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ElectionId" />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
        <!-- Committee Info -->
        <div class="ant-card">
            <div class="ant-card-head">
                <h3 class="ant-card-head-title flex items-center gap-2"><i class="fas fa-building text-primary-500"></i> بيانات اللجنة</h3>
            </div>
            <div class="ant-card-body space-y-5">
                <div class="ant-form-item">
                    <label class="ant-form-label">الانتخابات التابعة لها</label>
                    <select class="ant-select opacity-60 cursor-not-allowed" disabled>
                        @if(ViewBag.Elections != null)
                        {
                            foreach(var election in ViewBag.Elections as IEnumerable<AdvancedVotingSystem.Models.Election>)
                            {
                                @if (election.Id == Model.ElectionId)
                                {
                                    <option value="@election.Id" selected>@election.Name</option>
                                }
                                else
                                {
                                    <option value="@election.Id">@election.Name</option>
                                }
                            }
                        }
                    </select>
                    <p class="text-xs text-gray-400 mt-1">لا يمكن تغيير الانتخابات بعد إنشاء اللجنة.</p>
                </div>

                <div class="ant-form-item">
                    <label asp-for="Name" class="ant-form-label">اسم اللجنة <span class="text-danger-500">*</span></label>
                    <input asp-for="Name" class="ant-form-control" required />
                </div>

                @if (Model.Election?.EntryMethod == EntryMethod.UnknownCode)
                {
                    <div class="pt-4 border-t border-dashed border-gray-200 space-y-4">
                        <div class="ant-form-item">
                            <label class="ant-form-label"><i class="fas fa-clock text-primary-500 ml-1"></i> فترة التبريد</label>
                            <input type="number" asp-for="CooldownThreshold" min="1" max="100" class="ant-form-control" />
                        </div>
                        <div class="ant-form-item">
                            <label class="ant-form-label"><i class="fas fa-users text-primary-500 ml-1"></i> إجمالي عدد الناخبين المقيدين</label>
                            <input type="number" name="ManualRegisteredCount" value="@Model.RegisteredVotersCount" class="ant-form-control" />
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Team -->
        <div class="ant-card">
            <div class="ant-card-head">
                <h3 class="ant-card-head-title flex items-center gap-2"><i class="fas fa-users-cog text-primary-500"></i> فريق العمل</h3>
            </div>
            <div class="ant-card-body space-y-5">
                <div class="ant-form-item">
                    <label class="ant-form-label">رئيس اللجنة</label>
                    <select asp-for="HeadId" id="HeadId" class="ant-select">
                        <option value="">-- اختر رئيس اللجنة --</option>
                        @if (ViewBag.Heads != null)
                        {
                            foreach (var h in ViewBag.Heads as IEnumerable<AdvancedVotingSystem.Models.ApplicationUser>)
                            {
                                var idText = !string.IsNullOrEmpty(h.NationalId) ? $" ({h.NationalId})" : "";
                                @if (h.Id == Model.HeadId)
                                {
                                    <option value="@h.Id" selected>@h.FullName @idText</option>
                                }
                                else
                                {
                                    <option value="@h.Id">@h.FullName @idText</option>
                                }
                            }
                        }
                    </select>
                </div>

                <div class="ant-form-item">
                    <label class="ant-form-label">المشرفين المساعدين</label>
                    <input type="text" id="supervisorSearch" class="ant-form-control mb-3" placeholder="بحث عن مشرف..." />
                    <div id="supervisorsList" class="max-h-56 overflow-y-auto border-2 border-gray-200 rounded-xl p-3">
                        @if (ViewBag.Supervisors != null)
                        {
                            var supervisors = ViewBag.Supervisors as IEnumerable<AdvancedVotingSystem.Models.ApplicationUser>;
                            if (supervisors.Any())
                            {
                                foreach (var s in supervisors)
                                {
                                    var idText = !string.IsNullOrEmpty(s.NationalId) ? $" ({s.NationalId})" : "";
                                    var isChecked = s.CommitteeId == Model.Id ? "checked" : "";
                                    <label class="flex items-center gap-3 p-3 rounded-xl hover:bg-gray-50 cursor-pointer transition-colors">
                                        <input type="checkbox" name="supervisorIds" value="@s.Id" @isChecked class="ant-checkbox" />
                                        <span class="text-sm font-bold text-gray-700">@s.FullName <small class="text-gray-400 mr-1">@idText</small></span>
                                    </label>
                                }
                            }
                            else
                            {
                                <div class="text-center py-6 text-gray-400 font-bold text-sm"><i class="fas fa-info-circle"></i> لا يوجد مشرفين متاحين</div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5">
        <button type="submit" class="ant-btn ant-btn-primary ant-btn-lg w-full"><i class="fas fa-save"></i> حفظ التعديلات</button>
    </div>
</form>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const search = document.getElementById("supervisorSearch");
        const container = document.getElementById("supervisorsList");
        if (search && container) {
            search.addEventListener("keyup", function() {
                const term = this.value.toLowerCase();
                container.querySelectorAll('label').forEach(item => {
                    item.style.display = item.textContent.toLowerCase().includes(term) ? "flex" : "none";
                });
            });
        }
    });
</script>
}
