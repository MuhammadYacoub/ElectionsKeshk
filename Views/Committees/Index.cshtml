@model IEnumerable<AdvancedVotingSystem.Models.Committee>
@{
    ViewData["Title"] = "إدارة اللجان الانتخابية";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-cyan-50 text-cyan-600 flex items-center justify-center border border-cyan-100/50">
                <i class="fas fa-building text-sm"></i>
            </div>
            اللجان الانتخابية
        </h1>
        <p class="page-subtitle">إدارة وتنظيم اللجان الانتخابية</p>
    </div>
    <div class="flex items-center gap-3">
        <form method="get" id="filterForm" class="flex items-center gap-2 bg-white border border-gray-200 rounded-xl p-1 shadow-sm">
            <div class="pr-3 text-gray-400">
                <i class="fas fa-filter text-sm"></i>
            </div>
            <select name="electionId" id="electionId" onchange="document.getElementById('filterForm').submit()"
                    class="bg-transparent border-none text-gray-700 text-sm font-bold focus:ring-0 py-2 pr-2 pl-8 cursor-pointer outline-none min-w-[200px]">
                <option value="">-- عرض جميع الانتخابات --</option>
                @if (ViewBag.Elections != null)
                {
                    foreach (var election in ViewBag.Elections)
                    {
                        var isElSelected = ViewBag.CurrentElectionId != null && ViewBag.CurrentElectionId == election.Id;
                        if (isElSelected)
                        {
                            <option value="@election.Id" selected>@election.Name</option>
                        }
                        else
                        {
                            <option value="@election.Id">@election.Name</option>
                        }
                    }
                }
            </select>
        </form>
        <a asp-action="Create" class="ant-btn ant-btn-primary">
            <i class="fas fa-plus"></i>
            إنشاء لجنة جديدة
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="ant-alert ant-alert-success mb-5">
        <i class="fas fa-check-circle mt-0.5"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

<!-- Committees Table -->
<div class="ant-card">
    <div class="overflow-x-auto">
        <table class="ant-table">
            <thead>
                <tr>
                    <th>الانتخابات التابعة لها</th>
                    <th>اسم اللجنة</th>
                    <th class="text-center">رئيس اللجنة</th>
                    <th class="text-center">عدد المقيدين</th>
                    <th class="text-center">المشرفين المساعدين</th>
                    <th class="text-center">حالة اللجنة</th>
                    <th class="text-center">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-gray-500">@(item.Election != null ? item.Election.Name : "غير محدد")</td>
                            <td class="font-bold text-gray-900">@item.Name</td>
                            <td class="text-center text-gray-600">@(item.Head != null ? item.Head.FullName : "غير معين")</td>
                            <td class="text-center">
                                <span class="bg-gray-100 text-gray-800 font-bold px-3 py-1 rounded-lg text-sm">@item.RegisteredVotersCount</span>
                            </td>
                            <td class="text-center">
                                <span class="ant-tag ant-tag-default">@(item.Supervisors != null ? item.Supervisors.Count : 0)</span>
                            </td>
                            <td class="text-center">
                                @if (item.Status == AdvancedVotingSystem.Models.Enums.CommitteeStatus.Open)
                                {
                                    <span class="ant-tag ant-tag-success"><span class="ant-tag-dot bg-success-500"></span> مفتوحة</span>
                                }
                                else
                                {
                                    <span class="ant-tag ant-tag-danger"><span class="ant-tag-dot bg-danger-500"></span> مغلقة</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="ant-btn ant-btn-default ant-btn-sm">
                                        <i class="fas fa-edit text-xs"></i> تعديل
                                    </a>
                                    <button type="button" onclick="openDeleteModal('@item.Id', '@item.Name', '/Committees/Delete')"
                                            class="ant-btn ant-btn-sm border border-danger-200 text-danger-600 bg-danger-50/30 hover:bg-danger-600 hover:text-white hover:border-danger-600">
                                        <i class="fas fa-trash text-xs"></i> حذف
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7">
                            <div class="ant-empty">
                                <i class="fas fa-building ant-empty-icon text-5xl"></i>
                                <p class="ant-empty-text">لا توجد لجان مسجلة حالياً</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete Modal -->
<div id="deleteModal" class="ant-modal-overlay hidden" style="display:none;">
    <div class="ant-modal">
        <div class="p-8 text-center">
            <div class="mx-auto w-20 h-20 rounded-full bg-danger-50 flex items-center justify-center mb-5">
                <i class="fas fa-exclamation-triangle text-danger-500 text-3xl"></i>
            </div>
            <h3 class="text-xl font-black text-gray-900 mb-2">تأكيد الحذف</h3>
            <p class="text-gray-500 mb-1 font-medium">هل أنت متأكد أنك تريد حذف لجنة <strong id="modalCommitteeName" class="text-gray-900"></strong>؟</p>
            <p class="text-danger-500 text-xs font-bold mb-6">لا يمكن التراجع عن هذا الإجراء.</p>
            <form id="deleteForm" method="post" action="/Committees/Delete">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteModalId" value="" />
                <div class="flex gap-3">
                    <button type="button" onclick="closeDeleteModal()" class="ant-btn ant-btn-default flex-1">إلغاء</button>
                    <button type="submit" class="ant-btn ant-btn-danger flex-1"><i class="fas fa-trash"></i> نعم، احذف</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openDeleteModal(id, name, actionUrl) {
            document.getElementById('deleteModalId').value = id;
            document.getElementById('modalCommitteeName').textContent = '"' + name + '"';
            if (actionUrl) document.getElementById('deleteForm').action = actionUrl;
            gsapOpenModal('deleteModal');
        }
        function closeDeleteModal() { gsapCloseModal('deleteModal'); }
        document.getElementById('deleteModal').addEventListener('click', function(e) { if (e.target === this) closeDeleteModal(); });
    </script>
}
