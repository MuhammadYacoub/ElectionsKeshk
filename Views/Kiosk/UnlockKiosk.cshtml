@{
    Layout = "_KioskLayout";
    ViewData["Title"] = "فتح اللجنة الانتخابية";
}

<div class="flex items-center justify-center" style="min-height: 80vh;">
    <div class="w-full max-w-lg text-center">
        <div class="mb-8">
            <div class="w-24 h-24 rounded-full bg-white/10 border-2 border-white/20 flex items-center justify-center mx-auto mb-5">
                <i class="fas fa-unlock-alt text-accent-500 text-4xl"></i>
            </div>
            <h1 class="text-4xl font-black text-white mb-2" data-gsap="fade-up">فتح اللجنة الانتخابية</h1>
            <p class="text-white/60 text-lg font-medium">تسجيل دخول رئيس اللجنة</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="bg-danger-500/20 border border-danger-500/40 text-danger-300 p-5 rounded-2xl mb-6 text-lg font-bold backdrop-blur-sm">
                <i class="fas fa-exclamation-circle ml-2"></i> @TempData["Error"]
            </div>
        }

        <div class="bg-white/10 backdrop-blur-xl rounded-3xl p-8 border border-white/20 shadow-2xl" data-gsap="fade-up">
            <form asp-controller="Kiosk" asp-action="UnlockKiosk" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-5 text-right">
                    <label class="block text-white/80 font-bold text-lg mb-2">الرقم القومي</label>
                    <input type="text" name="nationalId"
                           class="w-full text-center text-2xl font-bold bg-white/10 border-2 border-white/30 text-white rounded-xl p-4 placeholder-white/40 focus:outline-none focus:border-accent-500 focus:bg-white/15 transition-all"
                           placeholder="أدخل الرقم القومي" required autocomplete="off" />
                </div>
                <div class="mb-6 text-right">
                    <label class="block text-white/80 font-bold text-lg mb-2">كلمة المرور</label>
                    <input type="password" name="password"
                           class="w-full text-center text-2xl font-bold bg-white/10 border-2 border-white/30 text-white rounded-xl p-4 placeholder-white/40 focus:outline-none focus:border-accent-500 focus:bg-white/15 transition-all"
                           placeholder="••••••••" required autocomplete="off" />
                </div>
                <button type="submit" class="w-full bg-accent-500 hover:bg-accent-600 text-white font-black text-xl py-4 rounded-2xl shadow-lg shadow-accent-500/30 transition-all duration-300 hover:scale-[1.02]">
                    <i class="fas fa-lock-open ml-2"></i> فتح صفحة الانتخاب
                </button>
            </form>
        </div>
    </div>
</div>
