<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام التصويت الإلكتروني</title>

    <!-- Google Fonts: Cairo -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Ant Design Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Tailwind CSS (compiled) -->
    <link href="~/css/tailwind-offline.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- GSAP Animation Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
</head>
<body class="gradient-page font-cairo min-h-screen">

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <!-- Brand -->
        <div class="sidebar-brand">
            <img src="~/images/logo.gif" alt="شعار هيئة قضايا الدولة" class="h-11 w-11 rounded-lg object-contain bg-white/10 p-1">
            <div class="flex flex-col leading-tight">
                <span class="text-white text-sm font-black">هيئة قضايا الدولة</span>
                <span class="text-gray-400 text-[11px] font-medium">نظام التصويت الإلكتروني</span>
            </div>
        </div>

        <!-- Navigation -->
        <nav class="mt-4 px-2 flex-1">
            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
            {
                <div class="px-3 mb-3 mt-2">
                    <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">القائمة الرئيسية</span>
                </div>

                <a asp-controller="Admin" asp-action="Index"
                   class="sidebar-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <i class="fas fa-chart-pie w-5 text-center"></i>
                    <span>لوحة التحكم</span>
                </a>

                <a asp-controller="Elections" asp-action="Index"
                   class="sidebar-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Elections" ? "active" : "")">
                    <i class="fas fa-vote-yea w-5 text-center"></i>
                    <span>إدارة الانتخابات</span>
                </a>

                <a asp-controller="Committees" asp-action="Index"
                   class="sidebar-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Committees" && ViewContext.RouteData.Values["action"]?.ToString() != "VotersList" ? "active" : "")">
                    <i class="fas fa-building w-5 text-center"></i>
                    <span>إدارة اللجان</span>
                </a>

                <a asp-controller="Committees" asp-action="VotersList"
                   class="sidebar-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "VotersList" ? "active" : "")">
                    <i class="fas fa-users w-5 text-center"></i>
                    <span>كشوف الناخبين</span>
                </a>

                <a asp-controller="Supervisors" asp-action="Index"
                   class="sidebar-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Supervisors" ? "active" : "")">
                    <i class="fas fa-user-shield w-5 text-center"></i>
                    <span>إدارة المشرفين</span>
                </a>

                <div class="px-3 mb-3 mt-6">
                    <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">التقارير والعمليات</span>
                </div>

                <a asp-controller="Admin" asp-action="GlobalReports"
                   class="sidebar-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "GlobalReports" ? "active" : "")">
                    <i class="fas fa-chart-bar w-5 text-center"></i>
                    <span>التقارير الشاملة</span>
                </a>

                <a asp-controller="Kiosk" asp-action="Index"
                   class="sidebar-nav-item">
                    <i class="fas fa-desktop w-5 text-center"></i>
                    <span>صفحة التصويت</span>
                </a>
            }
            else if (User.Identity?.IsAuthenticated == true && User.IsInRole("Supervisor"))
            {
                <div class="px-3 mb-3 mt-2">
                    <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">لوحة المشرف</span>
                </div>

                <a asp-controller="Supervisor" asp-action="Index"
                   class="sidebar-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Supervisor" ? "active" : "")">
                    <i class="fas fa-tachometer-alt w-5 text-center"></i>
                    <span>لوحة تحكم المشرف</span>
                </a>
            }
        </nav>

        <!-- User Section (bottom of sidebar) -->
        <div class="border-t border-white/10 p-4 mt-auto">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-9 h-9 rounded-xl gradient-primary flex items-center justify-center text-white text-sm font-bold">
                        <i class="fas fa-user"></i>
                    </div>
                    <div class="flex flex-col leading-tight">
                        <span class="text-white text-sm font-bold">@User.Identity.Name</span>
                        <span class="text-gray-500 text-[11px]">
                            @if (User.IsInRole("Admin")) { <text>مدير النظام</text> }
                            else if (User.IsInRole("Supervisor")) { <text>مشرف</text> }
                        </span>
                    </div>
                </div>
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    <button type="submit" class="w-full flex items-center justify-center gap-2 px-3 py-2 rounded-xl text-sm font-bold text-red-400 bg-red-500/10 hover:bg-red-500/20 transition-all duration-200">
                        <i class="fas fa-sign-out-alt text-xs"></i>
                        تسجيل الخروج
                    </button>
                </form>
            }
        </div>
    </aside>

    <!-- Main Content -->
    <div class="mr-[260px] min-h-screen flex flex-col" id="mainContent">

        <!-- Top Bar -->
        <header class="bg-white/80 backdrop-blur-md border-b border-gray-200/60 sticky top-0 z-30">
            <div class="flex items-center justify-between px-8 py-4">
                <div class="flex items-center gap-4">
                    <button onclick="toggleSidebar()" class="lg:hidden p-2 rounded-lg hover:bg-gray-100 transition-colors">
                        <i class="fas fa-bars text-gray-600"></i>
                    </button>
                    <div>
                        <h2 class="text-lg font-black text-gray-900">@ViewData["Title"]</h2>
                        <div class="ant-breadcrumb mt-0.5">
                            <span class="ant-breadcrumb-link"><i class="fas fa-home text-xs"></i></span>
                            <span class="ant-breadcrumb-separator">/</span>
                            <span class="text-gray-900 font-bold">@ViewData["Title"]</span>
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-4">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="hidden md:flex items-center gap-2 text-sm text-gray-600 bg-gray-50 px-4 py-2 rounded-xl">
                            <i class="fas fa-user-circle text-primary-500"></i>
                            <span class="font-bold">@User.Identity.Name</span>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login" class="ant-btn ant-btn-primary ant-btn-sm">
                            <i class="fas fa-sign-in-alt"></i>
                            تسجيل الدخول
                        </a>
                    }
                </div>
            </div>
        </header>

        <!-- Page Content -->
        <div class="flex-grow px-8 py-6">
            <main role="main">
                @RenderBody()
            </main>
        </div>

        <!-- Footer -->
        <footer class="bg-white/60 backdrop-blur-sm border-t border-gray-200/60 mt-auto py-4">
            <div class="text-center text-sm text-gray-500 font-medium">
                &copy; 2026 - نظام التصويت الإلكتروني - إدارة التحول الرقمي
                <span class="mx-2 text-gray-300">|</span>
                هيئة قضايا الدولة
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/gsap-init.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_GlobalAlerts" />
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const main = document.getElementById('mainContent');
            sidebar.classList.toggle('-translate-x-full');
            main.classList.toggle('mr-0');
            main.classList.toggle('mr-[260px]');
        }
    </script>
</body>
</html>
