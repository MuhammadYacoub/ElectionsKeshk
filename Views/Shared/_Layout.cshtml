<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - هيئة قضايا الدولة</title>

    <!-- Google Fonts: Cairo -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Tailwind CSS (compiled) -->
    <link href="~/css/tailwind-offline.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- GSAP Animation Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
</head>
<body class="gradient-page font-cairo min-h-screen text-slate-800">

    <!-- Mobile Sidebar Backdrop Overlay -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-slate-900/30 backdrop-blur-xs z-30 hidden lg:hidden" onclick="toggleSidebar()"></div>

    <!-- Sidebar -->
    <aside class="sidebar translate-x-full lg:translate-x-0 flex flex-col" id="sidebar">
        <!-- Brand / Logo -->
        <div class="sidebar-brand">
            <img src="~/images/logo.gif" alt="شعار هيئة قضايا الدولة" class="h-11 w-11 rounded-lg object-contain bg-slate-50 border border-slate-100 p-1">
            <div class="flex flex-col leading-tight">
                <span class="text-slate-800 text-sm font-black">هيئة قضايا الدولة</span>
                <span class="text-slate-400 text-[10px] font-bold">نظام التصويت الإلكتروني</span>
            </div>
        </div>

        <!-- Navigation Menu -->
        <nav class="mt-4 px-2 flex-1 overflow-y-auto">
            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
            {
                <div class="px-5 mb-2 mt-2">
                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">القائمة الرئيسية</span>
                </div>

                <a asp-controller="Admin" asp-action="Index"
                   class="sidebar-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <i class="fas fa-chart-pie w-5 text-center"></i>
                    <span>لوحة التحكم</span>
                </a>

                <a asp-controller="Elections" asp-action="Index"
                   class="sidebar-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Elections" ? "active" : "")">
                    <i class="fas fa-vote-yea w-5 text-center"></i>
                    <span>إدارة الانتخابات</span>
                </a>

                <a asp-controller="Committees" asp-action="Index"
                   class="sidebar-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Committees" && ViewContext.RouteData.Values["action"]?.ToString() != "VotersList" ? "active" : "")">
                    <i class="fas fa-building w-5 text-center"></i>
                    <span>إدارة اللجان</span>
                </a>

                <a asp-controller="Committees" asp-action="VotersList"
                   class="sidebar-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "VotersList" ? "active" : "")">
                    <i class="fas fa-users w-5 text-center"></i>
                    <span>كشوف الناخبين</span>
                </a>

                <a asp-controller="Supervisors" asp-action="Index"
                   class="sidebar-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Supervisors" ? "active" : "")">
                    <i class="fas fa-user-shield w-5 text-center"></i>
                    <span>إدارة المشرفين</span>
                </a>

                <div class="px-5 mb-2 mt-5">
                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">التقارير والعمليات</span>
                </div>

                <a asp-controller="Admin" asp-action="GlobalReports"
                   class="sidebar-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "GlobalReports" ? "active" : "")">
                    <i class="fas fa-chart-bar w-5 text-center"></i>
                    <span>التقارير الشاملة</span>
                </a>

                <a asp-controller="Kiosk" asp-action="Index"
                   class="sidebar-nav-item">
                    <i class="fas fa-desktop w-5 text-center"></i>
                    <span>واجهة التصويت (كشك)</span>
                </a>
            }
            else if (User.Identity?.IsAuthenticated == true && User.IsInRole("Supervisor"))
            {
                <div class="px-5 mb-2 mt-2">
                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">لوحة المشرف</span>
                </div>

                <a asp-controller="Supervisor" asp-action="Index"
                   class="sidebar-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Supervisor" ? "active" : "")">
                    <i class="fas fa-tachometer-alt w-5 text-center"></i>
                    <span>لوحة تحكم المشرف</span>
                </a>
            }
        </nav>

        <!-- User profile details & Logout -->
        <div class="border-t border-slate-100 p-4 mt-auto bg-slate-50/50">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-9 h-9 rounded-xl bg-primary-50 text-primary-600 flex items-center justify-center text-sm font-bold border border-primary-100/50">
                        <i class="fas fa-user"></i>
                    </div>
                    <div class="flex flex-col leading-tight">
                        <span class="text-slate-800 text-sm font-bold">@User.Identity.Name</span>
                        <span class="text-slate-400 text-[10px] font-bold">
                            @if (User.IsInRole("Admin")) { <text>مدير النظام</text> }
                            else if (User.IsInRole("Supervisor")) { <text>مشرف اللجنة</text> }
                        </span>
                    </div>
                </div>
                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="w-full flex items-center justify-center gap-2 px-3 py-2 rounded-xl text-xs font-bold text-danger-600 bg-danger-50 hover:bg-danger-100 border border-danger-100/30 transition-all duration-200 cursor-pointer">
                        <i class="fas fa-sign-out-alt"></i>
                        تسجيل الخروج
                    </button>
                </form>
            }
        </div>
    </aside>

    <!-- Main Page Layout Container -->
    <div class="lg:mr-[280px] min-h-screen flex flex-col transition-all duration-300" id="mainContent">

        <!-- Top Header Bar -->
        <header class="bg-white/80 backdrop-blur-md border-b border-slate-200/50 sticky top-0 z-30">
            <div class="flex items-center justify-between px-6 py-3.5">
                <div class="flex items-center gap-4">
                    <!-- Hamburger Menu Button (mobile only) -->
                    <button onclick="toggleSidebar()" class="lg:hidden p-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 transition-colors cursor-pointer text-slate-600">
                        <i class="fas fa-bars text-sm"></i>
                    </button>
                    <div>
                        <h2 class="text-base font-black text-slate-800">@ViewData["Title"]</h2>
                        <div class="ant-breadcrumb mt-0.5 text-xs">
                            <span class="ant-breadcrumb-link text-slate-400"><i class="fas fa-home text-[10px]"></i></span>
                            <span class="ant-breadcrumb-separator text-slate-300">/</span>
                            <span class="text-slate-600 font-bold">@ViewData["Title"]</span>
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-4">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="hidden md:flex items-center gap-2 text-xs text-slate-600 bg-slate-50 border border-slate-200/50 px-3 py-1.5 rounded-xl">
                            <span class="w-1.5 h-1.5 rounded-full bg-success-500"></span>
                            <span class="font-bold">@User.Identity.Name</span>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login" class="ant-btn ant-btn-primary ant-btn-sm">
                            <i class="fas fa-sign-in-alt"></i>
                            تسجيل الدخول
                        </a>
                    }
                </div>
            </div>
        </header>

        <!-- Main Page Content Section -->
        <div class="flex-grow px-6 py-6 lg:px-8">
            <main role="main">
                @RenderBody()
            </main>
        </div>

        <!-- Layout Footer -->
        <footer class="bg-white/60 backdrop-blur-xs border-t border-slate-200/50 mt-auto py-3">
            <div class="text-center text-xs text-slate-400 font-bold">
                &copy; 2026 - نظام التصويت الإلكتروني - إدارة التحول الرقمي
                <span class="mx-2 text-slate-200">|</span>
                هيئة قضايا الدولة
            </div>
        </footer>
    </div>

    <!-- Essential Layout Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/gsap-init.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_GlobalAlerts" />
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            
            // Toggle sidebar translate class
            sidebar.classList.toggle('translate-x-full');
            // Toggle overlay show state
            overlay.classList.toggle('hidden');
        }
    </script>
</body>
</html>
