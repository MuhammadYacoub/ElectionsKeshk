<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - نظام التصويت الإلكتروني</title>

    <!-- Google Fonts: Cairo -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Tailwind CSS -->
    <link href="~/css/tailwind-offline.css" rel="stylesheet" />

    <!-- GSAP -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>

    <style>
        body {
            font-family: 'Cairo', sans-serif;
            user-select: none;
            overflow-x: hidden;
            -webkit-user-select: none;
            touch-action: manipulation;
        }

        .kiosk-bg {
            background: linear-gradient(135deg, #0c1d3d 0%, #1e3a8a 40%, #162a56 100%);
            position: relative;
        }

        .kiosk-bg::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: radial-gradient(rgba(255,255,255,0.03) 1px, transparent 1px);
            background-size: 30px 30px;
            pointer-events: none;
        }

        .kiosk-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 24px;
        }

        .kiosk-input {
            background: rgba(255, 255, 255, 0.08);
            border: 2px solid rgba(255, 255, 255, 0.15);
            border-radius: 16px;
            color: white;
            font-size: 2.5rem;
            padding: 20px 24px;
            text-align: center;
            font-weight: 800;
            transition: all 0.3s ease;
            font-family: 'Cairo', sans-serif;
        }

        .kiosk-input:focus {
            border-color: #d4af37;
            background: rgba(255, 255, 255, 0.12);
            box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.2);
            outline: none;
        }

        .kiosk-input::placeholder {
            color: rgba(255, 255, 255, 0.3);
            font-size: 1.5rem;
        }

        .kiosk-btn {
            background: linear-gradient(135deg, #d4af37 0%, #f59e0b 100%);
            color: #0c1d3d;
            font-size: 1.5rem;
            font-weight: 900;
            padding: 18px 40px;
            border-radius: 16px;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 8px 25px rgba(212, 175, 55, 0.3);
            font-family: 'Cairo', sans-serif;
        }

        .kiosk-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 35px rgba(212, 175, 55, 0.4);
        }

        .kiosk-btn:active {
            transform: translateY(0);
        }

        .kiosk-btn-secondary {
            background: rgba(255, 255, 255, 0.1);
            color: white;
            border: 2px solid rgba(255, 255, 255, 0.2);
        }

        .kiosk-btn-secondary:hover {
            background: rgba(255, 255, 255, 0.15);
        }

        .kiosk-btn-success {
            background: linear-gradient(135deg, #059669 0%, #10b981 100%);
            color: white;
            box-shadow: 0 8px 25px rgba(16, 185, 129, 0.3);
        }

        .kiosk-btn-danger {
            background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%);
            color: white;
            box-shadow: 0 8px 25px rgba(239, 68, 68, 0.3);
        }

        .candidate-card {
            background: rgba(255, 255, 255, 0.06);
            border: 3px solid transparent;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            overflow: hidden;
        }

        .candidate-card:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
        }

        .candidate-card.selected {
            border-color: #d4af37;
            background: rgba(212, 175, 55, 0.15);
            box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.2), 0 12px 30px rgba(0, 0, 0, 0.3);
        }

        .candidate-card.selected::after {
            content: '\f00c';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            position: absolute;
            top: 12px;
            left: 12px;
            width: 32px;
            height: 32px;
            background: #d4af37;
            color: #0c1d3d;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
        }

        .glow-gold {
            box-shadow: 0 0 40px rgba(212, 175, 55, 0.15);
        }
    </style>
</head>
<body class="kiosk-bg min-h-screen flex flex-col items-center justify-center">
    <div class="w-full max-w-4xl mx-auto px-6 py-8">
        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/gsap-init.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
