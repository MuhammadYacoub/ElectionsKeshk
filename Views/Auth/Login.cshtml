@model AdvancedVotingSystem.Models.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "تسجيل الدخول";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تسجيل الدخول - نظام التصويت الإلكتروني</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="~/css/tailwind-offline.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <style>
        body { font-family: 'Cairo', sans-serif; }
        .login-bg {
            background: linear-gradient(135deg, #0c1d3d 0%, #1e3a8a 50%, #162a56 100%);
            position: relative;
            overflow: hidden;
        }
        .login-bg::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle, rgba(212,175,55,0.08) 0%, transparent 70%);
            pointer-events: none;
        }
        .login-bg::after {
            content: '';
            position: absolute;
            bottom: -30%;
            left: -30%;
            width: 80%;
            height: 80%;
            background: radial-gradient(circle, rgba(37,99,235,0.1) 0%, transparent 70%);
            pointer-events: none;
        }
        .login-glass {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }
        .login-decoration {
            background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.02) 100%);
            backdrop-filter: blur(10px);
        }
    </style>
</head>
<body class="login-bg min-h-screen flex items-center justify-center p-4">

    <div id="loginCard" class="w-full max-w-5xl flex rounded-3xl overflow-hidden shadow-2xl" style="min-height: 560px;">

        <!-- Right Panel - Decorative -->
        <div class="hidden lg:flex flex-col items-center justify-center w-5/12 login-decoration p-12 relative">
            <!-- Floating shapes -->
            <div class="absolute top-10 right-10 w-20 h-20 border border-white/10 rounded-2xl rotate-12" id="shape1"></div>
            <div class="absolute bottom-20 left-8 w-14 h-14 border border-white/10 rounded-full" id="shape2"></div>
            <div class="absolute top-1/3 left-12 w-8 h-8 bg-accent-500/20 rounded-lg rotate-45" id="shape3"></div>

            <img src="~/images/logo.gif" alt="شعار هيئة قضايا الدولة" class="h-28 w-28 rounded-2xl object-contain bg-white/10 p-3 mb-8" id="loginLogo">

            <h1 class="text-white text-2xl font-black text-center mb-3 leading-relaxed">هيئة قضايا الدولة</h1>
            <p class="text-gray-400 text-center text-sm font-medium leading-relaxed mb-8">
                نظام التصويت الإلكتروني المتقدم
                <br>
                إدارة التحول الرقمي
            </p>

            <!-- Decorative line -->
            <div class="flex items-center gap-2">
                <div class="h-1 w-8 rounded-full bg-success-500"></div>
                <div class="h-1 w-8 rounded-full bg-sla-navy"></div>
                <div class="h-1 w-8 rounded-full bg-danger-500"></div>
            </div>
        </div>

        <!-- Left Panel - Login Form -->
        <div class="w-full lg:w-7/12 login-glass p-10 lg:p-14 flex flex-col justify-center">
            <!-- Mobile Logo -->
            <div class="lg:hidden flex items-center gap-3 mb-8">
                <img src="~/images/logo.gif" alt="الشعار" class="h-12 w-12 rounded-xl object-contain">
                <div>
                    <h2 class="text-lg font-black text-gray-900">هيئة قضايا الدولة</h2>
                    <p class="text-xs text-gray-500">نظام التصويت الإلكتروني</p>
                </div>
            </div>

            <div class="mb-8">
                <h2 class="text-3xl font-black text-gray-900 mb-2">تسجيل الدخول</h2>
                <p class="text-gray-500 text-sm font-medium">أدخل بيانات الاعتماد الخاصة بك للوصول للنظام</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="ant-alert ant-alert-error mb-6">
                    <i class="fas fa-exclamation-circle mt-0.5"></i>
                    <span>@ViewBag.Error</span>
                </div>
            }

            <form asp-action="Login" method="POST" class="space-y-5">
                @Html.AntiForgeryToken()

                <!-- Username -->
                <div class="ant-form-item">
                    <label asp-for="Username" class="ant-form-label">
                        <i class="fas fa-user text-primary-500 ml-1"></i>
                        اسم المستخدم
                    </label>
                    <div class="relative">
                        <input asp-for="Username" required
                               class="ant-form-control ant-form-control-lg pr-12"
                               placeholder="أدخل اسم المستخدم" dir="ltr">
                        <div class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none">
                            <i class="fas fa-user text-gray-400"></i>
                        </div>
                    </div>
                    <span asp-validation-for="Username" class="text-danger-500 text-xs mt-1 block font-medium"></span>
                </div>

                <!-- Password -->
                <div class="ant-form-item">
                    <label asp-for="Password" class="ant-form-label">
                        <i class="fas fa-lock text-primary-500 ml-1"></i>
                        كلمة المرور
                    </label>
                    <div class="relative">
                        <input asp-for="Password" required type="password"
                               class="ant-form-control ant-form-control-lg pr-12"
                               placeholder="••••••••" dir="ltr">
                        <div class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none">
                            <i class="fas fa-lock text-gray-400"></i>
                        </div>
                    </div>
                    <span asp-validation-for="Password" class="text-danger-500 text-xs mt-1 block font-medium"></span>
                </div>

                <!-- Remember Me -->
                <div class="flex items-center gap-2">
                    <input asp-for="RememberMe" type="checkbox"
                           class="ant-checkbox">
                    <label asp-for="RememberMe" class="text-sm text-gray-600 font-medium cursor-pointer">
                        تذكرني
                    </label>
                </div>

                <!-- Submit -->
                <button type="submit" class="ant-btn ant-btn-primary ant-btn-lg w-full !rounded-xl mt-2">
                    <i class="fas fa-sign-in-alt"></i>
                    تسجيل الدخول
                </button>
            </form>

            <p class="text-center text-xs text-gray-400 mt-8 font-medium">
                &copy; 2026 هيئة قضايا الدولة - إدارة التحول الرقمي
            </p>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Animate floating shapes
            gsap.to('#shape1', { rotation: 360, duration: 20, repeat: -1, ease: 'none' });
            gsap.to('#shape2', { y: -15, duration: 3, repeat: -1, yoyo: true, ease: 'sine.inOut' });
            gsap.to('#shape3', { rotation: -360, scale: 1.2, duration: 8, repeat: -1, yoyo: true, ease: 'sine.inOut' });

            // Animate logo
            gsap.from('#loginLogo', { scale: 0.5, opacity: 0, duration: 0.8, ease: 'back.out(1.7)', delay: 0.3 });

            // Animate form
            gsap.from('.ant-form-item', { x: 30, opacity: 0, duration: 0.5, stagger: 0.1, ease: 'power2.out', delay: 0.4 });

            // Animate login card
            gsap.from('#loginCard', { scale: 0.9, opacity: 0, duration: 0.6, ease: 'power3.out' });
        });
    </script>
</body>
</html>
