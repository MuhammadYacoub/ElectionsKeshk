@model IEnumerable<AdvancedVotingSystem.Models.Election>
@using AdvancedVotingSystem.Extensions
@{
    ViewData["Title"] = "التقارير الشاملة";
}

<div class="page-header no-print">
    <div>
        <h1 class="page-title flex items-center gap-3 text-xl font-black text-foreground">
            <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center border border-primary/20">
                <i class="fas fa-chart-bar text-sm"></i>
            </div>
            التقارير الشاملة للانتخابات
        </h1>
        <p class="page-subtitle text-xs text-muted-foreground mt-1">عرض النتائج الإجمالية والنسب المئوية لجميع الانتخابات</p>
    </div>
    <button class="ant-btn ant-btn-default no-print border-border hover:bg-muted text-foreground" onclick="window.print()">
        <i class="fas fa-print text-muted-foreground"></i> طباعة التقرير
    </button>
</div>

@foreach (var election in Model)
{
    <div class="ant-card mb-8">
        <div class="ant-card-head bg-muted/20 border-b border-border">
            <div>
                <h3 class="text-foreground font-black text-base">@election.Name</h3>
                <div class="flex items-center gap-3 mt-1.5">
                    @if (election.Status == AdvancedVotingSystem.Models.Enums.ElectionStatus.Active)
                    {
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-600 border border-emerald-500/20">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> نشطة حالياً
                        </span>
                    }
                    else if (election.Status == AdvancedVotingSystem.Models.Enums.ElectionStatus.Closed)
                    {
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-muted text-muted-foreground border border-border">
                            <span class="w-1.5 h-1.5 rounded-full bg-muted-foreground/50"></span> مغلقة
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-blue-500/10 text-blue-600 border border-blue-500/20">
                            <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span> مسودة
                        </span>
                    }
                    <span class="text-muted-foreground text-xs font-bold font-numerals"><i class="far fa-calendar-alt ml-1"></i> @election.Date.ToShortDateString()</span>
                </div>
            </div>
        </div>
        
        <div class="ant-card-body bg-card">
            <h4 class="font-bold text-sm text-muted-foreground mb-5 flex items-center gap-2">
                <i class="fas fa-chart-pie text-muted-foreground/75"></i> تفاصيل النتائج الإجمالية حسب الفئات
            </h4>
            
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                @foreach (var category in election.Categories)
                {
                    <div class="border border-border/50 rounded-xl overflow-hidden bg-card shadow-xs">
                        <div class="px-5 py-3.5 bg-muted/30 border-b border-border flex justify-between items-center">
                            <span class="font-bold text-sm text-foreground">@category.Name</span>
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-primary/10 text-primary border border-primary/20">@category.CategoryType.GetDisplayName()</span>
                        </div>
                        <div class="divide-y divide-border/40">
                            @{
                                var candidatesList = category.Candidates.OrderByDescending(c => c.VoteRecords.Count(vr => vr.Selection)).ToList();
                                int rank = 1;
                            }
                            @foreach (var candidate in candidatesList)
                            {
                                var voteCount = candidate.VoteRecords.Count(vr => vr.Selection);
                                var totalVotes = category.Candidates.Sum(c => c.VoteRecords.Count(vr => vr.Selection));
                                double percentage = totalVotes > 0 ? Math.Round((double)voteCount / totalVotes * 100, 1) : 0;
                                bool isLeader = rank == 1 && voteCount > 0;
                                
                                <div class="flex items-center gap-4 p-4 hover:bg-muted/10 transition-colors relative group">
                                    @if (isLeader)
                                    {
                                        <div class="absolute top-0 bottom-0 right-0 w-1 bg-chart-2"></div>
                                    }
                                    
                                    <!-- Rank Number -->
                                    <div class="w-6 flex justify-center items-center font-bold text-muted-foreground text-xs font-numerals">
                                        @rank
                                    </div>
                                    
                                    <!-- Candidate Photo / Avatar -->
                                    <div class="w-10 h-10 rounded-full bg-muted text-muted-foreground border border-border flex-shrink-0 flex items-center justify-center font-black text-sm ring-2 ring-offset-2 ring-offset-card transition-all @(isLeader ? "ring-chart-2" : "ring-transparent group-hover:ring-border")">
                                        @if (!string.IsNullOrEmpty(candidate.ImagePath))
                                        {
                                            <img src="@candidate.ImagePath" class="w-full h-full rounded-full object-cover" alt="@candidate.Name" />
                                        }
                                        else
                                        {
                                            @candidate.Name.FirstOrDefault()
                                        }
                                    </div>
                                    
                                    <!-- Candidate Details & Progress -->
                                    <div class="flex-1 min-w-0 pr-2">
                                        <div class="flex justify-between items-center mb-1.5">
                                            <h4 class="font-bold text-foreground truncate text-xs flex items-center gap-1.5">
                                                @candidate.Name
                                                @if (isLeader)
                                                {
                                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[8px] font-black bg-chart-2/10 text-chart-2 border border-chart-2/20">
                                                        متصدر
                                                    </span>
                                                }
                                            </h4>
                                            <div class="text-left font-black text-sm font-numerals @(isLeader ? "text-chart-2" : "text-foreground")">
                                                @percentage%
                                            </div>
                                        </div>
                                        
                                        <div class="flex items-center gap-4">
                                            <!-- Progress bar -->
                                            <div class="h-2 flex-1 bg-muted rounded-full overflow-hidden border border-border/30">
                                                <div class="h-full rounded-full transition-all duration-500 @(isLeader ? "bg-chart-2" : "bg-primary/70 group-hover:bg-primary")" style="width: @(percentage)%"></div>
                                            </div>
                                            <span class="text-[10px] font-bold text-muted-foreground min-w-[85px] text-left bg-muted/50 px-2 py-0.5 rounded border border-border/50 font-numerals">
                                                @voteCount.ToString("N0") أصوات
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                rank++;
                            }
                            @if (!candidatesList.Any())
                            {
                                <div class="p-8 text-center text-muted-foreground">
                                    <i class="fas fa-info-circle text-lg mb-2 block text-muted-foreground/30"></i>
                                    لا يوجد مرشحين مسجلين في هذه الفئة
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
