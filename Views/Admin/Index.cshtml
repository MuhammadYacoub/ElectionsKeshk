@model AdvancedVotingSystem.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "لوحة تحكم الإدارة";
}

<!-- Statistics Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
    <!-- Total Voters -->
    <div class="ant-statistic">
        <div class="ant-statistic-icon bg-blue-50 text-blue-600">
            <i class="fas fa-users text-lg"></i>
        </div>
        <p class="ant-statistic-title">إجمالي الناخبين</p>
        <p class="ant-statistic-value" data-countup="@Model.TotalVoters">@Model.TotalVoters</p>
        <div class="mt-3 flex items-center gap-1.5 text-xs text-slate-400 font-bold">
            <i class="fas fa-chart-line text-blue-500"></i>
            <span>المسجلين في النظام</span>
        </div>
    </div>

    <!-- Total Committees -->
    <div class="ant-statistic">
        <div class="ant-statistic-icon bg-cyan-50 text-cyan-600">
            <i class="fas fa-building text-lg"></i>
        </div>
        <p class="ant-statistic-title">إجمالي اللجان</p>
        <p class="ant-statistic-value" data-countup="@Model.TotalCommittees">@Model.TotalCommittees</p>
        <div class="mt-3 flex items-center gap-1.5 text-xs text-slate-400 font-bold">
            <i class="fas fa-sitemap text-cyan-500"></i>
            <span>لجنة انتخابية مفعلة</span>
        </div>
    </div>

    <!-- Active Elections -->
    <div class="ant-statistic">
        <div class="ant-statistic-icon bg-emerald-50 text-emerald-600">
            <i class="fas fa-check-circle text-lg"></i>
        </div>
        <p class="ant-statistic-title">الانتخابات النشطة</p>
        <p class="ant-statistic-value" data-countup="@Model.ActiveElections">@Model.ActiveElections</p>
        <div class="mt-3 flex items-center gap-1.5 text-xs text-slate-400 font-bold">
            <i class="fas fa-bolt text-emerald-500 animate-pulse"></i>
            <span>عملية تصويت جارية الآن</span>
        </div>
    </div>

    <!-- Total Elections -->
    <div class="ant-statistic">
        <div class="ant-statistic-icon bg-indigo-50 text-indigo-600">
            <i class="fas fa-vote-yea text-lg"></i>
        </div>
        <p class="ant-statistic-title">إجمالي الانتخابات</p>
        <p class="ant-statistic-value" data-countup="@Model.TotalElections">@Model.TotalElections</p>
        <div class="mt-3 flex items-center gap-1.5 text-xs text-slate-400 font-bold">
            <i class="fas fa-database text-indigo-500"></i>
            <span>سجلات الانتخابات بقاعدة البيانات</span>
        </div>
    </div>
</div>

<!-- Quick Actions Section Header -->
<div class="mb-4">
    <h3 class="text-sm font-black text-slate-400 uppercase tracking-wider">عمليات الإدارة السريعة</h3>
</div>

<!-- Quick Actions -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-8">
    <!-- Elections Management -->
    <a asp-controller="Elections" asp-action="Index" class="ant-card group cursor-pointer hover:border-primary-300/80 transition-all duration-300">
        <div class="ant-card-body flex items-center gap-5">
            <div class="w-14 h-14 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300">
                <i class="fas fa-vote-yea text-xl"></i>
            </div>
            <div class="flex-1">
                <h3 class="text-base font-bold text-slate-800 mb-0.5 group-hover:text-primary-600 transition-colors">إدارة الانتخابات</h3>
                <p class="text-xs text-slate-400 font-medium">إضافة وتعديل وإدارة الهيكل التنظيمي للعملية الانتخابية</p>
            </div>
            <i class="fas fa-chevron-left text-slate-300 group-hover:text-primary-500 transition-all duration-300 transform group-hover:-translate-x-1"></i>
        </div>
    </a>

    <!-- Committees Management -->
    <a asp-controller="Committees" asp-action="Index" class="ant-card group cursor-pointer hover:border-cyan-300/80 transition-all duration-300">
        <div class="ant-card-body flex items-center gap-5">
            <div class="w-14 h-14 rounded-2xl bg-cyan-50 text-cyan-600 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300">
                <i class="fas fa-building text-xl"></i>
            </div>
            <div class="flex-1">
                <h3 class="text-base font-bold text-slate-800 mb-0.5 group-hover:text-cyan-600 transition-colors">إدارة اللجان</h3>
                <p class="text-xs text-slate-400 font-medium">إنشاء وتوزيع اللجان الفرعية وتسكين رؤساء اللجان والمساعدين</p>
            </div>
            <i class="fas fa-chevron-left text-slate-300 group-hover:text-cyan-500 transition-all duration-300 transform group-hover:-translate-x-1"></i>
        </div>
    </a>

    <!-- Reports -->
    <a asp-controller="Admin" asp-action="GlobalReports" class="ant-card group cursor-pointer hover:border-emerald-300/80 transition-all duration-300">
        <div class="ant-card-body flex items-center gap-5">
            <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300">
                <i class="fas fa-chart-bar text-xl"></i>
            </div>
            <div class="flex-1">
                <h3 class="text-base font-bold text-slate-800 mb-0.5 group-hover:text-emerald-600 transition-colors">التقارير الشاملة</h3>
                <p class="text-xs text-slate-400 font-medium">متابعة إحصائيات التصويت وعرض وطباعة النتائج النهائية</p>
            </div>
            <i class="fas fa-chevron-left text-slate-300 group-hover:text-emerald-500 transition-all duration-300 transform group-hover:-translate-x-1"></i>
        </div>
    </a>
</div>

<!-- Secondary Actions -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
    <a asp-controller="Supervisors" asp-action="Index" class="ant-card group cursor-pointer hover:border-amber-300/80 transition-all duration-300">
        <div class="ant-card-body flex items-center gap-5">
            <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300">
                <i class="fas fa-user-shield text-base"></i>
            </div>
            <div class="flex-1">
                <h3 class="text-sm font-bold text-slate-800 mb-0.5 group-hover:text-amber-600 transition-colors">إدارة المشرفين ورؤساء اللجان</h3>
                <p class="text-[11px] text-slate-400 font-medium">تسجيل حسابات المشرفين القضائيين والمساعدين وإدارتها</p>
            </div>
            <i class="fas fa-chevron-left text-slate-300 group-hover:text-amber-500 transition-all duration-300 transform group-hover:-translate-x-1"></i>
        </div>
    </a>

    <a asp-controller="Committees" asp-action="VotersList" class="ant-card group cursor-pointer hover:border-purple-300/80 transition-all duration-300">
        <div class="ant-card-body flex items-center gap-5">
            <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300">
                <i class="fas fa-clipboard-list text-base"></i>
            </div>
            <div class="flex-1">
                <h3 class="text-sm font-bold text-slate-800 mb-0.5 group-hover:text-purple-600 transition-colors">كشوف وجداول الناخبين</h3>
                <p class="text-[11px] text-slate-400 font-medium">البحث في جداول الناخبين ومراجعة وتصدير بيانات الحضور والتصويت</p>
            </div>
            <i class="fas fa-chevron-left text-slate-300 group-hover:text-purple-500 transition-all duration-300 transform group-hover:-translate-x-1"></i>
        </div>
    </a>
</div>
