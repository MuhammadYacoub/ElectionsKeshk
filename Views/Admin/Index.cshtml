@model AdvancedVotingSystem.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "لوحة تحكم الإدارة";
}

<!-- Statistics Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
    <!-- Total Voters -->
    <div class="ant-statistic gradient-accent text-white">
        <div class="ant-statistic-icon bg-white/20">
            <i class="fas fa-users text-2xl"></i>
        </div>
        <p class="ant-statistic-title text-white/80">إجمالي الناخبين</p>
        <p class="ant-statistic-value" data-countup="@Model.TotalVoters">@Model.TotalVoters</p>
        <div class="mt-3 flex items-center gap-1 text-xs text-white/60">
            <i class="fas fa-chart-line"></i>
            <span>المسجلين في النظام</span>
        </div>
    </div>

    <!-- Total Committees -->
    <div class="ant-statistic bg-gradient-to-br from-cyan-500 to-blue-600 text-white">
        <div class="ant-statistic-icon bg-white/20">
            <i class="fas fa-building text-2xl"></i>
        </div>
        <p class="ant-statistic-title text-white/80">إجمالي اللجان</p>
        <p class="ant-statistic-value" data-countup="@Model.TotalCommittees">@Model.TotalCommittees</p>
        <div class="mt-3 flex items-center gap-1 text-xs text-white/60">
            <i class="fas fa-sitemap"></i>
            <span>لجنة انتخابية</span>
        </div>
    </div>

    <!-- Active Elections -->
    <div class="ant-statistic gradient-success text-white">
        <div class="ant-statistic-icon bg-white/20">
            <i class="fas fa-check-circle text-2xl"></i>
        </div>
        <p class="ant-statistic-title text-white/80">الانتخابات النشطة</p>
        <p class="ant-statistic-value" data-countup="@Model.ActiveElections">@Model.ActiveElections</p>
        <div class="mt-3 flex items-center gap-1 text-xs text-white/60">
            <i class="fas fa-bolt"></i>
            <span>جارية الآن</span>
        </div>
    </div>

    <!-- Total Elections -->
    <div class="ant-statistic gradient-primary text-white">
        <div class="ant-statistic-icon bg-white/20">
            <i class="fas fa-vote-yea text-2xl"></i>
        </div>
        <p class="ant-statistic-title text-white/80">إجمالي الانتخابات</p>
        <p class="ant-statistic-value" data-countup="@Model.TotalElections">@Model.TotalElections</p>
        <div class="mt-3 flex items-center gap-1 text-xs text-white/60">
            <i class="fas fa-database"></i>
            <span>في قاعدة البيانات</span>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-8">
    <!-- Elections Management -->
    <a asp-controller="Elections" asp-action="Index" class="ant-card group cursor-pointer">
        <div class="ant-card-body flex items-center gap-5">
            <div class="w-14 h-14 rounded-2xl gradient-primary flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300">
                <i class="fas fa-vote-yea text-white text-xl"></i>
            </div>
            <div class="flex-1">
                <h3 class="text-base font-bold text-gray-900 mb-1">إدارة الانتخابات</h3>
                <p class="text-sm text-gray-500">إضافة وتعديل وإدارة الانتخابات</p>
            </div>
            <i class="fas fa-chevron-left text-gray-300 group-hover:text-primary-500 transition-colors"></i>
        </div>
    </a>

    <!-- Committees Management -->
    <a asp-controller="Committees" asp-action="Index" class="ant-card group cursor-pointer">
        <div class="ant-card-body flex items-center gap-5">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300">
                <i class="fas fa-building text-white text-xl"></i>
            </div>
            <div class="flex-1">
                <h3 class="text-base font-bold text-gray-900 mb-1">إدارة اللجان</h3>
                <p class="text-sm text-gray-500">إنشاء وتعديل اللجان الانتخابية</p>
            </div>
            <i class="fas fa-chevron-left text-gray-300 group-hover:text-primary-500 transition-colors"></i>
        </div>
    </a>

    <!-- Reports -->
    <a asp-controller="Admin" asp-action="GlobalReports" class="ant-card group cursor-pointer">
        <div class="ant-card-body flex items-center gap-5">
            <div class="w-14 h-14 rounded-2xl gradient-success flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300">
                <i class="fas fa-chart-bar text-white text-xl"></i>
            </div>
            <div class="flex-1">
                <h3 class="text-base font-bold text-gray-900 mb-1">التقارير الشاملة</h3>
                <p class="text-sm text-gray-500">عرض وطباعة التقارير</p>
            </div>
            <i class="fas fa-chevron-left text-gray-300 group-hover:text-primary-500 transition-colors"></i>
        </div>
    </a>
</div>

<!-- Secondary Actions -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
    <a asp-controller="Supervisors" asp-action="Index" class="ant-card group cursor-pointer">
        <div class="ant-card-body flex items-center gap-5">
            <div class="w-12 h-12 rounded-xl bg-amber-50 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300">
                <i class="fas fa-user-shield text-amber-600 text-lg"></i>
            </div>
            <div class="flex-1">
                <h3 class="text-base font-bold text-gray-900 mb-0.5">إدارة المشرفين</h3>
                <p class="text-xs text-gray-500">إضافة وإدارة المشرفين ورؤساء اللجان</p>
            </div>
            <i class="fas fa-chevron-left text-gray-300 group-hover:text-primary-500 transition-colors"></i>
        </div>
    </a>

    <a asp-controller="Committees" asp-action="VotersList" class="ant-card group cursor-pointer">
        <div class="ant-card-body flex items-center gap-5">
            <div class="w-12 h-12 rounded-xl bg-purple-50 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300">
                <i class="fas fa-clipboard-list text-purple-600 text-lg"></i>
            </div>
            <div class="flex-1">
                <h3 class="text-base font-bold text-gray-900 mb-0.5">كشوف الناخبين</h3>
                <p class="text-xs text-gray-500">عرض وتصدير بيانات الناخبين</p>
            </div>
            <i class="fas fa-chevron-left text-gray-300 group-hover:text-primary-500 transition-colors"></i>
        </div>
    </a>
</div>
