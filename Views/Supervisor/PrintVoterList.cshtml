@model AdvancedVotingSystem.Models.Committee

@{
    Layout = null;
    ViewData["Title"] = "طباعة قائمة الناخبين المحدثة";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - @Model.Election.Name</title>
    <link href="~/css/local-cairo.css" rel="stylesheet" />
    <style>
        :root {
            --gov-navy: #0f172a;
            --gov-gold: #d97706;
            --gov-gold-light: #fef3c7;
            --gov-white: #ffffff;
            --gov-gray: #f8fafc;
            --border-color: #e2e8f0;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: var(--gov-white);
            color: var(--gov-navy);
            margin: 0;
            padding: 20px;
        }

        .print-header {
            text-align: center;
            border-bottom: 3px solid var(--gov-gold);
            padding-bottom: 10px;
            margin-bottom: 30px;
        }

        .print-header h1 {
            color: var(--gov-navy);
            font-weight: 800;
            margin: 0;
            font-size: 2rem;
        }

        .print-header h2 {
            color: #475569;
            font-weight: 600;
            margin: 10px 0 0 0;
            font-size: 1.5rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
        }

        th, td {
            border: 2px solid var(--border-color);
            padding: 12px;
            text-align: center;
            vertical-align: middle;
        }

        th {
            background-color: var(--gov-navy);
            color: var(--gov-white);
            font-weight: 700;
            font-size: 1.2rem;
        }

        tr:nth-child(even) {
            background-color: var(--gov-gray);
        }

        .barcode-container {
            padding: 5px;
            background-color: var(--gov-white);
            border-radius: 5px;
        }

        .login-code {
            font-weight: 800;
            font-size: 1.3rem;
            letter-spacing: 2px;
            color: var(--gov-gold);
        }

        @@media print {
            body {
                padding: 0;
            }
            .no-print {
                display: none !important;
            }
            @@page {
                size: A4;
                margin: 20mm;
            }
            table {
                page-break-inside: auto;
            }
            tr {
                page-break-inside: avoid;
                page-break-after: auto;
            }
        }
    </style>
</head>
<body>

    <div class="print-header">
        <h1>@Model.Election.Name</h1>
        <h2>قائمة أرقام الدخول - @Model.Name</h2>
    </div>

    <div class="text-start mb-4 no-print" style="margin-bottom: 20px;">
        <button onclick="window.print()" style="background-color: var(--gov-gold); color: white; padding: 10px 20px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; font-family: 'Cairo'; font-size: 1.1rem;">
            طباعة القائمة
        </button>
        <a href="/Supervisor/Index" style="background-color: var(--gov-navy); color: white; padding: 10px 20px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; font-family: 'Cairo'; font-size: 1.1rem; text-decoration: none; margin-right: 10px;">
            رجوع
        </a>
    </div>

    <table>
        <thead>
            <tr>
                <th style="width: 10%;">م</th>
                <th style="width: 40%;">رقم الدخول (الكود السري)</th>
                <th style="width: 50%;">الباركود (للمسح بالكشك)</th>
            </tr>
        </thead>
        <tbody>
            @{ int index = 1; }
            @foreach (var voter in Model.Voters)
            {
                <tr>
                    <td style="font-weight: bold; font-size: 1.2rem;">@index</td>
                    <td class="login-code">@voter.LoginIdentifier</td>
                    <td>
                        <div class="barcode-container">
                            <svg class="barcode-svg" data-value="@voter.LoginIdentifier"></svg>
                        </div>
                    </td>
                </tr>
                index++;
            }
        </tbody>
    </table>

    <script src="~/js/JsBarcode.all.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const svgs = document.querySelectorAll('.barcode-svg');
            svgs.forEach(function (svg) {
                const value = svg.getAttribute('data-value');
                JsBarcode(svg, value, {
                    format: "CODE128",
                    displayValue: false,
                    width: 2,
                    height: 50,
                    margin: 0
                });
            });
        });
    </script>
</body>
</html>
