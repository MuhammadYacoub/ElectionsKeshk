@model AdvancedVotingSystem.Models.Committee
@using AdvancedVotingSystem.Models.Enums
@{
    ViewData["Title"] = "لوحة تحكم المشرف";
}

<div class="page-header">
    <div>
        <h1 class="page-title flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-primary-50 text-primary-600 flex items-center justify-center border border-primary-100/50">
                <i class="fas fa-tachometer-alt text-sm"></i>
            </div>
            لوحة تحكم المشرف
        </h1>
        <p class="page-subtitle">إدارة اللجنة والإشراف على سير عملية التصويت</p>
    </div>
</div>

<!-- Stats -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-8">
    <!-- Registered Voters -->
    <div class="ant-statistic">
        <div class="ant-statistic-icon bg-blue-50 text-blue-600">
            <i class="fas fa-users text-lg"></i>
        </div>
        <p class="ant-statistic-title">الناخبين المقيدين</p>
        <p class="ant-statistic-value" data-countup="@Model.Voters.Count">@Model.Voters.Count</p>
        <div class="mt-3 flex items-center gap-1.5 text-xs text-slate-400 font-bold">
            <i class="fas fa-clipboard-list text-blue-500"></i>
            <span>إجمالي أعضاء الجمعية العمومية للجنة</span>
        </div>
    </div>

    <!-- Votes Cast -->
    <div class="ant-statistic">
        <div class="ant-statistic-icon bg-emerald-50 text-emerald-600">
            <i class="fas fa-check-double text-lg"></i>
        </div>
        <p class="ant-statistic-title">الأصوات المدلى بها</p>
        <p class="ant-statistic-value" data-countup="@Model.TotalVotesCast">@Model.TotalVotesCast</p>
        <div class="mt-3 flex items-center gap-1.5 text-xs text-slate-400 font-bold">
            <i class="fas fa-vote-yea text-emerald-500"></i>
            <span>عدد الأصوات الصحيحة والباطلة المسجلة</span>
        </div>
    </div>

    <!-- Committee Status -->
    <div class="ant-statistic">
        <div class="ant-statistic-icon @(Model.Status == CommitteeStatus.Open ? "bg-amber-50 text-amber-600" : "bg-rose-50 text-rose-600")">
            <i class="fas fa-@(Model.Status == CommitteeStatus.Open ? "lock-open" : "lock") text-lg"></i>
        </div>
        <p class="ant-statistic-title">حالة اللجنة الحالية</p>
        <p class="ant-statistic-value text-2xl font-black @(Model.Status == CommitteeStatus.Open ? "text-amber-600" : "text-rose-600")" style="line-height: 2.25rem;">
            @(Model.Status == CommitteeStatus.Open ? "مفتوحة للتصويت" : "مغلقة نهائياً")
        </p>
        <div class="mt-3 flex items-center gap-1.5 text-xs text-slate-400 font-bold">
            <i class="fas fa-shield-alt @(Model.Status == CommitteeStatus.Open ? "text-amber-500" : "text-rose-500")"></i>
            <span>حالة الإغلاق تمنع أي عمليات اقتراع جديدة</span>
        </div>
    </div>
</div>

<!-- Committee Info -->
<div class="ant-card mb-6">
    <div class="ant-card-head border-b border-slate-100">
        <h3 class="ant-card-head-title flex items-center gap-2">
            <i class="fas fa-building text-slate-400 text-sm"></i> معلومات وبيانات اللجنة
        </h3>
    </div>
    <div class="ant-card-body">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="flex items-center gap-3 p-4 bg-slate-50/50 border border-slate-100 rounded-xl">
                <i class="fas fa-building text-primary-500 text-base"></i>
                <div>
                    <span class="text-[10px] text-slate-400 font-bold">اسم اللجنة</span>
                    <p class="text-sm font-black text-slate-700">@Model.Name</p>
                </div>
            </div>
            <div class="flex items-center gap-3 p-4 bg-slate-50/50 border border-slate-100 rounded-xl">
                <i class="fas fa-vote-yea text-primary-500 text-base"></i>
                <div>
                    <span class="text-[10px] text-slate-400 font-bold">الانتخابات التابع لها</span>
                    <p class="text-sm font-black text-slate-700">@Model.Election?.Name</p>
                </div>
            </div>
        </div>

        <div class="mt-5">
            <a asp-action="PrintVoterList" asp-route-id="@Model.Id" target="_blank" class="ant-btn ant-btn-default border-slate-200">
                <i class="fas fa-print text-slate-400"></i> طباعة قائمة البطاقات (الباركود)
            </a>
        </div>
    </div>
</div>

<!-- Actions -->
<div class="ant-card">
    <div class="ant-card-head border-b border-slate-100">
        <h3 class="ant-card-head-title flex items-center gap-2">
            <i class="fas fa-cog text-slate-400 text-sm"></i> إجراءات التحكم باللجنة
        </h3>
    </div>
    <div class="ant-card-body">
        @if (Model.Status == CommitteeStatus.Open)
        {
            <div class="ant-alert ant-alert-warning mb-5">
                <i class="fas fa-exclamation-triangle mt-0.5"></i>
                <span>إغلاق اللجنة إجراء نهائي وقانوني لا يمكن التراجع عنه وسينهي عملية الاقتراع في الكشك فوراً.</span>
            </div>
            <form asp-action="CloseCommittee" method="post" onsubmit="return confirm('هل أنت متأكد من رغبتك في إغلاق هذه اللجنة نهائياً؟');" class="m-0">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="ant-btn ant-btn-danger w-full !rounded-xl">
                    <i class="fas fa-lock"></i> إغلاق اللجنة نهائياً وإنهاء التصويت
                </button>
            </form>
        }
        else
        {
            <div class="ant-alert ant-alert-info mb-5">
                <i class="fas fa-info-circle mt-0.5"></i>
                <span>هذه اللجنة مغلقة حالياً. تم حظر وإيقاف استقبال أي أصوات جديدة في الكشك.</span>
            </div>
            <a asp-action="PrintResults" asp-route-id="@Model.Id" target="_blank" class="ant-btn ant-btn-primary w-full !rounded-xl">
                <i class="fas fa-file-alt"></i> طباعة وعرض محضر فرز نتائج اللجنة
            </a>
        }
    </div>
</div>
